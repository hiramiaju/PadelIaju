# Acceso al panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Número institucional para el botón de WhatsApp: país + número, sin + ni espacios
INSTITUTE_WHATSAPP=5215500000000

# Carpeta donde viven reservas.json y bloqueos.json.
# Local: déjalo así. En Render puedes usar /var/data si montas un Persistent Disk.
DATA_DIR=./data

# Zona horaria utilizada para validar fechas y estadísticas
LOCAL_TIMEZONE=America/Mexico_City

# Correo automático (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@ejemplo.com
SMTP_PASS=tu-clave-o-contrasena-de-aplicacion
FROM_EMAIL=tu-correo@ejemplo.com
ADMIN_EMAIL=

# Desarrollo local
PORT=5000
FLASK_DEBUG=1
